    <!-- Const: MENU_SHOW_RELEASE_TRACKER    -->
    <item android:id="@+id/action_show_release_tracker"
        android:title="Book Release Tracker"
        android:orderInCategory="26"
        app:showAsAction="never" />
    <!-- Const: MENU_RANDOMIZE -->
    <item android:id="@+id/action_randomize_list"
        android:title="Randomize"
        android:orderInCategory="30"
        app:showAsAction="never" />

