<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.Monsoon.lists.MainActivity" >
    <!-- Actions with icons will have orderInCategory 1 - 10 -->
    <!-- Const: MENU_ADD -->
    <item android:id="@+id/action_add"
        android:title="Add"
        android:icon="@android:drawable/ic_input_add"
        android:orderInCategory="1"
        app:showAsAction="ifRoom" />
    <!-- Const: MENU_DONE -->
    <item android:id="@+id/action_done"
        android:title="Done"
        android:icon="@drawable/done_24dp"
        android:orderInCategory="2"
        app:showAsAction="ifRoom" />
    <!-- Const: MENU_EDIT -->
    <item android:id="@+id/action_edit"
        android:title="Edit"
        android:icon="@android:drawable/ic_menu_edit"
        android:orderInCategory="3"
        app:showAsAction="ifRoom" />
    <!-- Const: MENU_DELETE -->
    <item android:id="@+id/action_delete"
        android:title="Delete"
        android:icon="@android:drawable/ic_menu_delete"
        android:orderInCategory="10"
        app:showAsAction="ifRoom" />



    <!-- Actions without icons will have orderInCategory 10 - 99 -->
    <!-- Const: MENU_MOVE_TO_FRONT -->
    <item android:id="@+id/action_move_to_front"
        android:title="Move To Front"
        android:orderInCategory="20"
        app:showAsAction="never" />
    <!-- Const: MENU_MOVE_TO_BACK -->
    <item android:id="@+id/action_move_to_back"
        android:title="Move To back"
        android:orderInCategory="21"
        app:showAsAction="never" />
    <!-- Const: MENU_RANDOM_TO_FRONT -->
    <item android:id="@+id/action_random_to_front"
        android:title="Random To Front"
        android:orderInCategory="22"
        app:showAsAction="never" />
    <!-- Const: MENU_RANDOMIZE -->
    <item android:id="@+id/action_randomize_list"
        android:title="Randomize"
        android:orderInCategory="30"
        app:showAsAction="never" />

    <!-- Settings will have orderInCategory 100 -->
    <!-- Const: MENU_SETTINGS -->
    <item android:id="@+id/action_settings"
        android:title="@string/action_settings"
        android:orderInCategory="100"
        app:showAsAction="never" />

</menu>