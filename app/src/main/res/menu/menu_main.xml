<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.Monsoon.lists.MainActivity" >
    <!-- Actions with icons will have orderInCategory 1 - 10 -->
    <!-- Const: MENU_ADD -->
    <item android:id="@+id/action_add"
        android:title="Add"
        android:icon="@android:drawable/ic_input_add"
        android:orderInCategory="1"
        app:showAsAction="ifRoom" />
    <!-- Const: MENU_DONE -->
    <item android:id="@+id/action_done"
        android:title="Done"
        android:icon="@drawable/check_24"
        android:orderInCategory="2"
        app:showAsAction="ifRoom" />
    <!-- Const: MENU_EDIT -->
    <item android:id="@+id/action_edit"
        android:title="Edit"
        android:icon="@android:drawable/ic_menu_edit"
        android:orderInCategory="3"
        app:showAsAction="ifRoom" />
    <!-- Const: MENU_DELETE -->
    <item android:id="@+id/action_delete"
        android:title="Delete"
        android:icon="@android:drawable/ic_menu_delete"
        android:orderInCategory="10"
        app:showAsAction="ifRoom" />



    <!-- Actions without icons will have orderInCategory 10 - 99 -->
    <!-- Const: MENU_SELECT_ALL -->
    <item android:id="@+id/action_select_all"
        android:title="Select all"
        android:orderInCategory="11"
        app:showAsAction="never" />
    <!-- Const: MENU_DESELECT_ALL -->
    <item android:id="@+id/action_deselect_all"
        android:title="Deselect all"
        android:orderInCategory="12"
