<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/ListOfListsFragment">

    <fragment
        android:id="@+id/ListOfListsFragment"
        android:name="com.Monsoon.lists.fragments.ListOfListsFragment"
        android:label="@string/lists"
        tools:layout="@layout/list_of_lists_fragment">

        <action
            android:id="@+id/action_load_basic_list"
            app:destination="@id/basic_list_fragment" />
        <action
            android:id="@+id/action_load_todo_list"
            app:destination="@id/todo_list_fragment" />
        <action
            android:id="@+id/action_load_numbered_list"
            app:destination="@id/numbered_list_fragment" />
        <action
            android:id="@+id/action_load_book_list"
            app:destination="@id/book_list_fragment" />

    </fragment>
    <fragment
        android:id="@+id/basic_list_fragment"
        android:name="com.Monsoon.lists.fragments.BasicListFragment"
        android:label="@string/basic_list"
        tools:layout="@layout/basic_list_fragment" >

        <action
            android:id="@+id/action_return_to_lists_of_lists"
            app:destination="@id/ListOfListsFragment" />
    </fragment>
    <fragment
        android:id="@+id/todo_list_fragment"
        android:name="com.Monsoon.lists.fragments.TodoListFragment"
        android:label="@string/todo_list"
        tools:layout="@layout/todo_list_fragment" >

        <action
            android:id="@+id/action_return_to_lists_of_lists"
            app:destination="@id/ListOfListsFragment" />
    </fragment>
    <fragment
        android:id="@+id/numbered_list_fragment"
        android:name="com.Monsoon.lists.fragments.NumberedListFragment"
        android:label="@string/numbered_list"
        tools:layout="@layout/numbered_list_fragment" >


        <action
            android:id="@+id/action_return_to_lists_of_lists"
            app:destination="@id/ListOfListsFragment" />
    </fragment>
    <fragment
        android:id="@+id/book_list_fragment"
        android:name="com.Monsoon.lists.fragments.BookListFragment"
        android:label="@string/book_list"
        tools:layout="@layout/fragment_book_list" >

        <action
            android:id="@+id/action_return_to_lists_of_lists"
            app:destination="@id/ListOfListsFragment" />
    </fragment>


</navigation>