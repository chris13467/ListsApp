<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.SeriesReleaseTrackerFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/upcoming_books_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPCOMING BOOKS"
            android:layout_margin="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/book_list_view"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/book_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toBottomOf="@id/upcoming_books_banner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/estimated_upcoming_books_banner"
            android:layout_margin="16dp">

        </androidx.recyclerview.widget.RecyclerView>

        <TextView
            android:id="@+id/estimated_upcoming_books_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESTIMATED BOOK RELEASE DATES"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/book_list_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/estimated_book_list_view"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/estimated_book_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toBottomOf="@id/estimated_upcoming_books_banner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_margin="16dp">

        </androidx.recyclerview.widget.RecyclerView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>