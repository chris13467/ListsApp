<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.BookSeriesFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- add boot to Series section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/add_book_pane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/num_books_text_view"
            android:visibility="gone">

            <TextView
                android:id="@+id/new_book_number"
                android:text="1"
                android:paddingStart="24dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@id/book_title_input"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/is_upcoming"/>
            <EditText
                android:id="@+id/book_title_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:autofillHints="NONE"
                android:inputType="text"
                android:hint="@string/enter_book_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/new_book_number"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/is_upcoming"/>

            <CheckBox
                android:id="@+id/is_upcoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:text="@string/is_this_an_upcoming_book"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/book_title_input"
                app:layout_constraintBottom_toTopOf="@id/book_release_date_picker"/>

            <EditText
                android:id="@+id/book_release_date_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:autofillHints="NONE"
                android:inputType="date"
                android:focusable="false"
                android:clickable="true"
                android:hint="@string/select_release_date"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/is_upcoming"
                app:layout_constraintBottom_toBottomOf="parent"/>



        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Book stats section -->
        <!-- Author of Series -->
        <TextView
            android:id="@+id/series_author_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/add_book_pane"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/num_books_text_view"
            app:layout_constraintBottom_toTopOf="@id/next_upcoming_release_text_view"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"/>
        <!-- Number of books and number of books Read -->
        <TextView
            android:id="@+id/num_books_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0/0)"
            app:layout_constraintTop_toBottomOf="@id/add_book_pane"
            app:layout_constraintStart_toEndOf="@id/series_author_text_view"
            app:layout_constraintEnd_toStartOf="@id/diamond_icon"
            app:layout_constraintBottom_toTopOf="@id/next_upcoming_release_text_view"
            android:layout_marginTop="12dp"/>
        <!-- Are there any upcoming releases -->
        <ImageView
            android:id="@+id/diamond_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/diamond_icon"
            app:layout_constraintTop_toBottomOf="@id/add_book_pane"
            app:layout_constraintStart_toEndOf="@id/num_books_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/next_upcoming_release_text_view"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"/>
        <TextView
            android:id="@+id/next_upcoming_release_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/num_books_text_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/book_series_tags_text_view"
            android:layout_margin="12dp"/>

        <TextView
            android:id="@+id/book_series_tags_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/next_upcoming_release_text_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/books_in_series_view"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"/>
        <!-- Series Tags -->

        <!-- List of books in Series section -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/books_in_series_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toBottomOf="@id/book_series_tags_text_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/upcoming_section_books"
            android:paddingTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

        </androidx.recyclerview.widget.RecyclerView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/upcoming_section_books"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/books_in_series_view">


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/upcoming_books_in_series_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:paddingBottom="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

            </androidx.recyclerview.widget.RecyclerView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>